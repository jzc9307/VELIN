<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>VELIN</AssemblyName><RootNamespace>Velin.Windows</RootNamespace>
    <ApplicationIcon>../../Resources/VELIN.ico</ApplicationIcon>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <FileVersion>$(Version).$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../BUILD_NUMBER').Trim())</FileVersion>
    <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="../../Resources/UpdatePublicKey.txt" LogicalName="UpdatePublicKey" /></ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)obj/worker/ReleaseNotes.json')"><EmbeddedResource Include="obj/worker/ReleaseNotes.json" LogicalName="ReleaseNotes" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../VELIN.Core/VELIN.Core.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /><PackageReference Include="System.Speech" Version="10.0.14" /></ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)obj/worker/VelinSpeech.exe')"><EmbeddedResource Include="obj/worker/VelinSpeech.exe" LogicalName="VelinSpeech.exe" /></ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)obj/worker/THIRD-PARTY-NOTICES.txt')"><EmbeddedResource Include="obj/worker/THIRD-PARTY-NOTICES.txt" LogicalName="ThirdPartyNotices" /></ItemGroup>
</Project>
